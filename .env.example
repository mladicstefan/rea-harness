# Copy to .env and adjust. Every value has a default inside the container.

# ---------------------------------------------------------------------------
# Model server (runs on the HOST, GPU stays on the host).
# generic         : any OpenAI-compatible /v1 endpoint
#                   (llama-server -m ..., vLLM, Ollama, LM Studio, SGLang)
# llamacpp-router : llama.cpp router mode (`llama serve` without -m), uses
#                   Pi's builtin llama.cpp integration; pick the model with /model
LLM_MODE=generic

# host.docker.internal resolves to the host from inside the container
# (NAT bridge). Your server must listen on 0.0.0.0 or on the docker0 address,
# not only on 127.0.0.1.
LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
LOCAL_LLM_API_KEY=local
# The model id your server reports under /v1/models
LOCAL_LLM_MODEL=qwen2.5-coder-14b-instruct
# Must match the server's context size (llama-server -c 32768)
LOCAL_LLM_CONTEXT_WINDOW=32768
LOCAL_LLM_MAX_TOKENS=4096
# true for thinking models (Qwen3, DeepSeek-R1 ...)
LOCAL_LLM_REASONING=false
# openai | qwen | deepseek | openrouter | chat-template
LOCAL_LLM_THINKING_FORMAT=openai
# max_tokens for llama.cpp/vLLM/Ollama, max_completion_tokens for OpenAI-style proxies
LOCAL_LLM_MAX_TOKENS_FIELD=max_tokens

# llamacpp-router mode only
LLAMA_BASE_URL=http://host.docker.internal:8080
LLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Context budget (tuned for a 32k window; see README "Context budget")
# codemode : MCP tools are reachable only from codemode scripts (nothing in the prompt)
# deferred : MCP tools are loaded on demand via tool_search (classic tool calls)
PI_MCP_EXPOSURE=codemode
# on   : built-in tools declared normally + codemode
# only : everything behind the single codemode tool
PI_CODEMODE_MODE=on
PI_CODEMODE_INLINE_BUDGET=1500
PI_COMPACTION_RESERVE=6144
PI_COMPACTION_KEEP_RECENT=8192
# off | minimal | low | medium | high (clamped to what the model supports)
PI_THINKING=off

# ---------------------------------------------------------------------------
# REA (reverse engineering MCP)
# Families advertised by the server. Web/Electron work needs no native engine.
# Add native,artifact for Mach-O/ELF work (requires Ghidra/Hopper on top).
REA_TOOL_FAMILIES=browser,electron,application,javascript-runtime,session
REA_INPUT_SCHEMA_PROFILE=compact
REA_OUTPUT_SCHEMA_PROFILE=off
REA_MAX_RESPONSE_BYTES=65536
REA_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Chrome DevTools MCP / shared Chromium
# 1 => --slim (3 tools: navigate, evaluate, screenshot)
CHROME_SLIM=0
CDP_PORT=9222
CHROMIUM_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Host paths
WORKSPACE=./workspace
